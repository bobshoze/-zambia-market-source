<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Zed Market – Zambia Business Directory</title>
<meta name="description" content="Find businesses, vehicles, property, building materials, electronics, services and farm produce in Zambia. Contact sellers directly on WhatsApp.">
<style>
:root{--bg:#f5f6f2;--card:#fff;--tx:#16201a;--mu:#5b6a60;--br:#dfe5de;--pr:#0a6b3d;--pr2:#064d2b;--ac:#d98e04;--wa:#1a9e52;--sf:#eaf2ec;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media(prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0e1411;--card:#17201b;--tx:#eef3ef;--mu:#9aab9f;--br:#2a362f;--pr:#3fbf7a;--pr2:#2e9a60;--sf:#1b2a22}}
:root[data-theme="dark"]{--bg:#0e1411;--card:#17201b;--tx:#eef3ef;--mu:#9aab9f;--br:#2a362f;--pr:#3fbf7a;--pr2:#2e9a60;--sf:#1b2a22}
*,*::before,*::after{box-sizing:inherit}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg);color:var(--tx);font:16px/1.5 "Segoe UI",system-ui,-apple-system,Roboto,sans-serif}
a{color:inherit;text-decoration:none}
h1,h2,h3{line-height:1.2;margin:0 0 .5rem;font-family:Georgia,"Times New Roman",serif;letter-spacing:-.01em}
h1{font-size:1.9rem}h2{font-size:1.4rem}h3{font-size:1.1rem}
p{margin:0 0 .8rem}
.w{max-width:1000px;margin:0 auto;padding:0 16px}
header{position:sticky;top:env(safe-area-inset-top,0px);z-index:20;background:var(--card);border-bottom:1px solid var(--br)}
.hb{display:flex;align-items:center;justify-content:space-between;height:56px}
.logo{font:700 1.25rem Georgia,serif;color:var(--pr)}
.logo span{color:var(--ac)}
nav{display:flex;gap:4px;overflow-x:auto;padding-bottom:8px;scrollbar-width:none}
nav a{white-space:nowrap;padding:6px 12px;border-radius:99px;font-size:.9rem;color:var(--mu)}
nav a.on{background:var(--sf);color:var(--pr);font-weight:600}
.bn{background:#fff4d6;color:#5c4200;font-size:.82rem;padding:8px 16px;text-align:center}
.hero{background:var(--pr2);color:#fff;padding:28px 0 32px}
.hero h1{color:#fff}.hero p{opacity:.9}
.chips{display:flex;gap:6px;flex-wrap:wrap;margin-top:12px}.chips a{background:#ffffff26;color:#fff;padding:5px 12px;border-radius:99px;font-size:.85rem}
.sf{display:grid;gap:8px;margin-top:16px}
@media(min-width:640px){.sf{grid-template-columns:1fr 200px auto}}
input,select,button{font:inherit}
input,select{width:100%;padding:12px;border:1px solid var(--br);border-radius:10px;background:var(--card);color:var(--tx)}
:focus-visible{outline:3px solid var(--ac);outline-offset:2px}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;padding:12px 18px;border-radius:10px;border:0;background:var(--ac);color:#1d1400;font-weight:700;cursor:pointer}
.btn.pr{background:var(--pr);color:#fff}
.btn.wa{background:var(--wa);color:#fff}
.btn.ol{background:transparent;border:1px solid var(--br);color:var(--tx)}
.btn.bl{display:flex;width:100%}
section{padding:24px 0}
.sh{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:12px}
.sh a{color:var(--pr);font-weight:600;font-size:.9rem}
.cats{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}
@media(min-width:640px){.cats{grid-template-columns:repeat(4,1fr)}}
.cat{background:var(--card);border:1px solid var(--br);border-left:5px solid var(--c);border-radius:12px;padding:12px}
.cat b{display:block;font-size:.95rem;line-height:1.25}
.cat small{color:var(--mu)}
.cat .i{font-size:1.6rem}
.grid{display:grid;gap:14px}
@media(min-width:560px){.grid{grid-template-columns:repeat(2,1fr)}}
@media(min-width:860px){.grid{grid-template-columns:repeat(3,1fr)}}
.card{background:var(--card);border:1px solid var(--br);border-radius:14px;overflow:hidden;display:flex;flex-direction:column}
.th{display:flex;align-items:center;justify-content:center;aspect-ratio:16/10;background:linear-gradient(135deg,var(--c),#0003 140%);font-size:3rem;position:relative}
.th img{width:100%;height:100%;object-fit:cover}
.bd{position:absolute;top:8px;left:8px;display:flex;gap:4px;flex-wrap:wrap}
.tag{font:600 .72rem system-ui,sans-serif;padding:3px 8px;border-radius:99px;background:#fff;color:#222}
.tag.f{background:var(--ac)}.tag.s{background:#7c3aed;color:#fff}.tag.x{background:#222;color:#fff}
.cb{padding:12px;display:flex;flex-direction:column;gap:6px;flex:1}
.pz{font-weight:700;color:var(--pr)}
.mt{color:var(--mu);font-size:.85rem}
.cb .btn{margin-top:auto}
.fl{display:grid;gap:8px;margin-bottom:14px}
@media(min-width:640px){.fl{grid-template-columns:2fr 1fr 1fr}}
.box{background:var(--card);border:1px solid var(--br);border-radius:14px;padding:16px;margin-bottom:14px}
.pk{display:grid;gap:14px}
@media(min-width:760px){.pk{grid-template-columns:repeat(4,1fr)}}
.pk .box{display:flex;flex-direction:column;margin:0}
.pk .box.hl{border:2px solid var(--ac)}
.pk ul{padding-left:18px;margin:0 0 12px;color:var(--mu);font-size:.92rem}
.pk .btn{margin-top:auto}
.dl{display:grid;gap:8px;margin:12px 0}
.dl div{display:flex;gap:10px}
.dl b{min-width:90px;color:var(--mu);font-weight:600}
.big{aspect-ratio:16/9;border-radius:14px;overflow:hidden;margin-bottom:14px}
.big .th{height:100%;aspect-ratio:auto;font-size:5rem}
.em{text-align:center;padding:30px 10px;color:var(--mu)}
footer{background:var(--card);border-top:1px solid var(--br);padding:20px 0 28px;margin-top:20px;font-size:.9rem;color:var(--mu)}
footer a{margin-right:14px;color:var(--pr)}
.fw{position:fixed;right:14px;bottom:calc(14px + env(safe-area-inset-bottom,0px));z-index:30;box-shadow:0 4px 14px #0004;border-radius:99px}
</style></head><body>
<header><div class="w"><div class="hb"><a class="logo" href="#/">Zed<span>Market</span></a><a class="btn pr" style="padding:8px 14px" href="#/advertise">Advertise</a></div>
<nav id="nav"></nav></div></header>
<div id="bn"></div>
<main id="app"></main>
<footer><div class="w" id="ft"></div></footer>
<script>
/* ============ EDIT THIS SECTION TO UPDATE THE SITE ============ */
const CFG={
  name:"Zed Market",
  tagline:"Find businesses, products and services in Zambia",
  city:"Lusaka",
  wa:"260976265393",            // WhatsApp number: country code + number, no + or spaces
  waShow:"+260 976 265 393",
  email:"zambiamarketsource@gmail.com"
};
/* Add a category by adding one line here. id must be unique. */
const CATS=[
 {id:"cars",n:"Cars & Vehicles",i:"🚗",c:"#2f6fd6",d:"Cars, trucks, bikes, spares",k:"car cars vehicle toyota nissan honda hilux suv truck pickup motorbike bike spares tyres taxi bus minibus"},
 {id:"property",n:"Property, Houses & Land",i:"🏠",c:"#c2410c",d:"Rent, buy, plots",k:"house houses home flat apartment rent rental plot plots land stand lodge boarding bedroom"},
 {id:"construction",n:"Construction & Building Materials",i:"🏗️",c:"#a16207",d:"Builders, cement, steel",k:"builder contractor construction cement bricks roofing steel timber paint tiles hardware plumbing materials"},
 {id:"electronics",n:"Electronics & Appliances",i:"📱",c:"#7c3aed",d:"Phones, TVs, fridges",k:"phone smartphone mobile laptop computer tv television fridge freezer stove solar speaker iphone samsung"},
 {id:"services",n:"Professional & Home Services",i:"🛠️",c:"#0e7490",d:"Plumbers, lawyers, cleaners",k:"plumber electrician cleaner cleaning lawyer accountant mechanic repair tutor salon photographer catering transport"},
 {id:"agri",n:"Agriculture & Farm Produce",i:"🌽",c:"#4d7c0f",d:"Crops, livestock, inputs",k:"maize groundnuts vegetables tomato onion livestock cattle goats chickens eggs fertilizer seed farm farming produce"},
 {id:"goods",n:"Furniture, Clothing & General Goods",i:"🛋️",c:"#be185d",d:"Home and fashion",k:"sofa bed furniture wardrobe table chairs clothes clothing shoes dress shirt chitenge fashion"},
 {id:"other",n:"Other Businesses & Services",i:"🏪",c:"#475569",d:"Everything else",k:"business service shop general other"}
];
/* Listings. tier: "free" | "standard" | "featured". sp:true = sponsored on homepage.
   ok:true = approved and visible (set false to hide). s:1 = sample (remove when real).
   img: optional photo as a data: URI (remote image links are blocked on published pages).
   k: optional extra search keywords. ph: optional phone shown only if the seller approves it.
   Example: {id:1,cat:"cars",t:"Toyota Hilux 2018",b:"Business name",d:"Description",p:"K0",loc:"Lusaka",ph:"",wa:"26097xxxxxxx",tier:"free",sp:false,ok:true,k:"pickup 4x4 diesel"} */
const L=[
 
 
 
 
 
 
 
 
 
 
];
/* Advertising packages. Set your own prices in "price". */
const PK=[
 {n:"Free Basic",price:"Free",f:["Basic listing in your category","Name, description, location","WhatsApp and phone button","Subject to approval"]},
 {n:"Standard",price:"Contact us for rates",f:["Everything in Basic","More text and photos","Ranked above free listings","Listed for an agreed period"]},
 {n:"Featured",price:"Contact us for rates",hl:1,f:["Everything in Standard","Featured badge","Top of category pages","Shown in homepage Featured"]},
 {n:"Sponsored Homepage",price:"Contact us for rates",f:["Premium homepage slot","Sponsored badge","Maximum visibility","Limited slots, agreed period"]}
];
/* ============ END OF EDIT SECTION ============ */

const $=id=>document.getElementById(id);
const esc=s=>String(s??"").replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
const cat=id=>CATS.find(c=>c.id===id)||CATS[CATS.length-1];
const POP=["Toyota","House to rent","Plot","Cement","Plumber","Smartphone","Maize","Sofa"];
const SYN={car:["vehicle","auto"],vehicle:["car","auto"],house:["property","home","rent"],home:["house","property"],rent:["rental","lease"],land:["plot","stand"],plot:["land","stand"],phone:["smartphone","mobile"],tv:["television"],builder:["contractor","construction"],plumber:["plumbing"],maize:["mealie","farm"],farm:["agriculture","produce","livestock"],clothe:["clothing","fashion"],sofa:["furniture","couch"],lawyer:["legal","attorney"]};
const STOP=["in","for","the","a","of","near","and","to","me","buy","sale","sell","with"];
const stem=w=>w.length>3&&w.endsWith("s")?w.slice(0,-1):w;
const toks=s=>(String(s||"").toLowerCase().match(/[a-z0-9]+/g)||[]).map(stem);
const hay=x=>{const c=cat(x.cat);return toks([x.t,x.b,x.d,x.loc,c.n,c.k,x.k].join(" "))};
const hit=(h,w)=>[w,...(SYN[w]||[])].some(v=>h.some(t=>t.startsWith(v)));
const match=(x,q)=>{const h=hay(x);return toks(q).filter(w=>!STOP.includes(w)).every(w=>hit(h,w))};
const dl=()=>'<datalist id="kw">'+[...new Set([...POP,...CATS.map(c=>c.n),...L.filter(x=>x.ok).map(x=>x.t)])].map(s=>`<option value="${esc(s)}">`).join("")+'</datalist>';
const rank=x=>(x.sp?3:0)+({featured:2,standard:1,free:0}[x.tier]||0);
const live=()=>L.filter(x=>x.ok).sort((a,b)=>rank(b)-rank(a));
const wal=(n,m)=>`https://wa.me/${n}?text=${encodeURIComponent(m)}`;
const wbtn=(x,cls="")=>`<a class="btn wa ${cls}" href="${wal(x.wa||CFG.wa,`Hello, I saw "${x.t}" on ${CFG.name}.`)}" target="_blank" rel="noopener">💬 WhatsApp</a>`;
const tags=x=>(x.sp?'<span class="tag s">Sponsored</span>':'')+(x.tier==="featured"?'<span class="tag f">Featured</span>':'')+(x.s?'<span class="tag x">Sample</span>':'');
const thumb=x=>{const c=cat(x.cat);return `<div class="th" style="--c:${c.c}">${x.img?`<img src="${esc(x.img)}" alt="" loading="lazy">`:c.i}<div class="bd">${tags(x)}</div></div>`};
const card=x=>`<article class="card"><a href="#/listing/${x.id}">${thumb(x)}</a><div class="cb"><a href="#/listing/${x.id}"><h3>${esc(x.t)}</h3></a><div class="mt">${esc(x.b)} · 📍 ${esc(x.loc)}</div>${x.p?`<div class="pz">${esc(x.p)}</div>`:""}${wbtn(x,"bl")}</div></article>`;
const cards=a=>a.length?`<div class="grid">${a.map(card).join("")}</div>`:`<div class="em">${live().length?"No listings match. Try different keywords or browse a category.":"No listings yet. Be the first to advertise here."}<br><a href="#/advertise"><u>Advertise with us</u></a></div>`;

const NAV=[["#/","Home"],["#/directory","Directory"],["#/advertise","Advertise"],["#/about","About"],["#/contact","Contact"],["#/policy","Policy"]];

function home(){
  const f=live().filter(x=>x.sp),g=live().filter(x=>x.tier==="featured"&&!x.sp);
  return `<div class="hero"><div class="w"><h1>${esc(CFG.tagline)}</h1><p>Browse listings in ${esc(CFG.city)} and across Zambia. Contact sellers directly on WhatsApp.</p>
  <form class="sf" id="sf"><input id="q" list="kw" autocomplete="off" placeholder="Keywords: toyota, plot, plumber…" aria-label="Search by keyword"><select id="qc" aria-label="Category"><option value="">All categories</option>${CATS.map(c=>`<option value="${c.id}">${esc(c.n)}</option>`).join("")}</select><button class="btn">Search</button></form><div class="chips">${POP.map(k=>`<a href="#/directory?q=${encodeURIComponent(k)}">${esc(k)}</a>`).join("")}</div>${dl()}</div></div>
  <section><div class="w"><div class="sh"><h2>Categories</h2></div><div class="cats">${CATS.map(c=>`<a class="cat" style="--c:${c.c}" href="#/category/${c.id}"><span class="i">${c.i}</span><b>${esc(c.n)}</b><small>${esc(c.d)}</small></a>`).join("")}</div></div></section>
  ${f.length?`<section><div class="w"><div class="sh"><h2>Sponsored</h2></div>${cards(f)}</div></section>`:""}
  ${g.length?`<section><div class="w"><div class="sh"><h2>Featured listings</h2><a href="#/directory">View all</a></div>${cards(g)}</div></section>`:""}${live().length?"":`<section><div class="w"><div class="box"><h2>Listings are coming soon</h2><p>We are adding our first businesses now. List your business for free, or ask about a Featured or Sponsored spot.</p><a class="btn wa" target="_blank" rel="noopener" href="${wal(CFG.wa,"Hello, I would like to list my business on "+CFG.name)}">💬 List my business</a></div></div></section>`}
  <section><div class="w"><div class="box"><h2>Want customers to find your business?</h2><p>Get listed for free, or choose a Featured or Sponsored package. Contact us on WhatsApp to get started.</p><a class="btn" href="#/advertise">See advertising packages</a></div></div></section>`;
}
function listView(title,intro,fixed,q0){
  const locs=[...new Set(live().map(x=>x.loc))].sort();
  return `<section><div class="w"><h1>${esc(title)}</h1><p class="mt">${esc(intro)}</p>
  <div class="fl"><input id="fq" list="kw" autocomplete="off" placeholder="Keywords: toyota, plot, plumber…" value="${esc(q0||"")}" aria-label="Search by keyword">
  ${fixed?"":`<select id="fc" aria-label="Category"><option value="">All categories</option>${CATS.map(c=>`<option value="${c.id}">${esc(c.n)}</option>`).join("")}</select>`}
  <select id="fl" aria-label="Location"><option value="">All locations</option>${locs.map(l=>`<option>${esc(l)}</option>`).join("")}</select></div>
  <div id="res"></div>${dl()}</div></section>`;
}
function bindList(fixed,c0){
  const run=()=>{const q=$("fq").value,c=fixed||($("fc")||{}).value||"",l=$("fl").value;
    $("res").innerHTML=cards(live().filter(x=>(!c||x.cat===c)&&(!l||x.loc===l)&&(!q||match(x,q))))};
  if($("fc"))$("fc").value=c0||"";
  ["fq","fc","fl"].forEach(i=>$(i)&&$(i).addEventListener("input",run));run();
}
function listing(id){
  const x=L.find(a=>a.id==id&&a.ok);if(!x)return `<section><div class="w em">Listing not found. <a href="#/directory"><u>Browse the directory</u></a></div></section>`;
  const c=cat(x.cat),rel=live().filter(a=>a.cat===x.cat&&a.id!==x.id).slice(0,3);
  return `<section><div class="w"><p class="mt"><a href="#/category/${c.id}">← ${esc(c.n)}</a></p>
  <div class="big">${thumb(x)}</div><h1>${esc(x.t)}</h1>${x.p?`<div class="pz" style="font-size:1.3rem;margin-bottom:8px">${esc(x.p)}</div>`:""}
  <div class="box"><p>${esc(x.d)}</p><div class="dl"><div><b>Seller</b><span>${esc(x.b)}</span></div><div><b>Location</b><span>${esc(x.loc)}</span></div><div><b>Category</b><span>${esc(c.n)}</span></div>${x.ph?`<div><b>Phone</b><a href="tel:${esc(x.ph.replace(/\s/g,""))}"><u>${esc(x.ph)}</u></a></div>`:""}</div>
  ${wbtn(x,"bl")}<p class="mt" style="margin:10px 0 0">Always meet in a safe place and check items before paying. See our <a href="#/policy"><u>listing policy</u></a>. <a href="${wal(CFG.wa,`Report listing: ${x.t} (ID ${x.id})`)}" target="_blank" rel="noopener"><u>Report this listing</u></a></p></div>
  ${rel.length?`<h2>More in ${esc(c.n)}</h2>${cards(rel)}`:""}</div></section>`;
}
function advertise(){
  const m=n=>wal(CFG.wa,`Hello, I would like to advertise on ${CFG.name}. Package: ${n}.`);
  return `<section><div class="w"><h1>Advertise with us</h1><p>Reach customers searching for businesses, products and services in Zambia. Every listing is reviewed before it goes live.</p>
  <div class="pk">${PK.map(p=>`<div class="box ${p.hl?"hl":""}"><h3>${esc(p.n)}</h3><p class="pz">${esc(p.price)}</p><ul>${p.f.map(f=>`<li>${esc(f)}</li>`).join("")}</ul><a class="btn ${p.hl?"":"pr"}" target="_blank" rel="noopener" href="${m(p.n)}">💬 Ask on WhatsApp</a></div>`).join("")}</div>
  <div class="box" style="margin-top:14px"><h2>How it works</h2><ol><li>Message us on WhatsApp with your business name and the package you want.</li><li>Send your listing text, photos, location and contact details.</li><li>For paid packages, we confirm your payment manually.</li><li>We review and approve your listing, then publish it.</li></ol><p class="mt">There is no online checkout. Paid promotions start only after payment is confirmed.</p></div></div></section>`;
}
function page(t,body){return `<section><div class="w"><h1>${t}</h1><div class="box">${body}</div></div></section>`}
const ABOUT=page("About us",`<p>${esc(CFG.name)} is a Zambian directory and marketplace that helps customers find businesses, products and services, and contact sellers directly.</p><p>We start in ${esc(CFG.city)} and plan to grow across the country. Listings are free to browse. Businesses can get a free basic listing or pay for Standard, Featured and Sponsored placements.</p><p>We do not sell on behalf of sellers. Deals are made directly between buyer and seller.</p>`);
const CONTACT=()=>page("Contact us",`<p>Want to list or advertise your business? Message us.</p><div class="dl"><div><b>WhatsApp</b><a href="${wal(CFG.wa,"Hello, I have a question about "+CFG.name)}" target="_blank" rel="noopener"><u>${esc(CFG.waShow)}</u></a></div><div><b>Email</b><a href="mailto:${esc(CFG.email)}"><u>${esc(CFG.email)}</u></a></div></div><a class="btn wa" target="_blank" rel="noopener" href="${wal(CFG.wa,"Hello, I would like to list my business on "+CFG.name)}">💬 Message on WhatsApp</a>`);
const POLICY=page("Listing policy",`<h3>What we list</h3><p>Genuine businesses, products and services in Zambia, described honestly and with accurate contact details.</p><h3>Approval</h3><p>Every listing is reviewed and approved by us before it appears. We may edit, refuse or remove any listing.</p><h3>Not allowed</h3><p>Illegal goods or services, stolen items, counterfeit products, misleading prices or photos, scams, and offensive content.</p><h3>Paid listings</h3><p>Standard, Featured and Sponsored placements start after we manually confirm payment. Placement does not mean we endorse a seller.</p><h3>Staying safe</h3><p>We do not handle payments between buyers and sellers. Meet in safe public places, inspect items, and never pay in advance to people you do not know.</p><p class="mt">Report a problem listing through the Contact page.</p>`);

function route(){
  const [p,qs]=(location.hash.slice(1)||"/").split("?"),s=p.split("/").filter(Boolean),P=new URLSearchParams(qs||"");
  let h="",after=()=>{};
  if(!s.length){h=home();after=()=>$("sf").onsubmit=e=>{e.preventDefault();location.hash="#/directory?q="+encodeURIComponent($("q").value)+"&c="+$("qc").value}}
  else if(s[0]==="directory"){h=listView("Business directory","All approved listings. Search or filter below.",0,P.get("q"));after=()=>bindList(0,P.get("c"))}
  else if(s[0]==="category"){const c=CATS.find(x=>x.id===s[1]);if(c){h=listView(c.i+" "+c.n,c.d,c.id);after=()=>bindList(c.id)}else h=`<section><div class="w em">Category not found.</div></section>`}
  else if(s[0]==="listing")h=listing(s[1]);
  else if(s[0]==="advertise")h=advertise();
  else if(s[0]==="about")h=ABOUT;
  else if(s[0]==="contact")h=CONTACT();
  else if(s[0]==="policy")h=POLICY;
  else h=home();
  $("app").innerHTML=h;after();scrollTo(0,0);
  const cur="#/"+(s[0]||"");
  $("nav").innerHTML=NAV.map(n=>`<a href="${n[0]}" class="${n[0]===cur||(s[0]==="category"&&n[0]==="#/directory")||(s[0]==="listing"&&n[0]==="#/directory")?"on":""}">${n[1]}</a>`).join("");
  document.title=CFG.name+" – Zambia Business Directory";
}
$("bn").innerHTML=L.some(x=>x.ok&&x.s)?'<div class="bn">Sample listings are shown for demonstration only. They are not real businesses.</div>':"";
$("ft").innerHTML=`<p><b>${esc(CFG.name)}</b> · ${esc(CFG.tagline)}</p><p>${NAV.map(n=>`<a href="${n[0]}">${n[1]}</a>`).join("")}</p><p>Listings are submitted by sellers and approved by us. We do not handle payments between buyers and sellers.</p>`;
document.body.insertAdjacentHTML("beforeend",`<a class="btn wa fw" aria-label="Chat with us on WhatsApp" target="_blank" rel="noopener" href="${wal(CFG.wa,"Hello, I have a question about "+CFG.name)}">💬 Chat</a>`);
addEventListener("hashchange",route);route();
</script></body></html>
